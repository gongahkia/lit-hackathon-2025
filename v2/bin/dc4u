#!/usr/bin/env perl

use strict;
use warnings;
use v5.32;

use FindBin;
use lib "$FindBin::Bin/../lib";

use DC4U;
use DC4U::Theme;
use Getopt::Long qw(:config pass_through);
use Pod::Usage;
use File::Basename;

=head1 NAME

dc4u - Draft Charges 4 U - Legal Document Generator

=head1 SYNOPSIS

    dc4u [options] [input_file ...]
    dc4u <subcommand> [args]

  Subcommands:
    init   <jurisdiction> <out.dc>     Scaffold a starter .dc file
    lint   <file.dc> [...]             Validate .dc against jurisdiction rules
    anonymize <in.dc> [-o out.dc]      Strip PII (--strategy redact|hash|fake)
    diff   <a.dc> <b.dc>               Field-level semantic diff
    bundle <file.dc> [--zip out.zip]   Render multi-format bundle + manifest
    batch  --csv f.csv --template t.dc CSV-driven batch rendering
    theme  list|create|dir             Manage color themes
    audit  [--tail N]                  Show append-only audit log

  Generator options (file mode):
    --format, -f FORMAT       Output format (PDF, HTML, TXT, MD, RMD, DOCX)
    --output, -o FILE         Output file
    --config, -c FILE         Configuration file
    --jurisdiction, -j J      Jurisdiction (singapore, uk, australia, india, malaysia)
    --theme, -t THEME         Color theme (see --list-themes)
    --watermark TEXT          Apply DRAFT/CONFIDENTIAL/etc. watermark
    --watch                   Recompile on file save (Ctrl-C to stop)
    --lint                    Run lint before generating; abort on error
    --audit-log               Record this generation in ~/.dc4u/audit.log
    --no-preprocess           Skip @include/@def/${var}/YAML front-matter
    --list-themes             Print available themes and exit
    --batch, -b               Batch processing mode
    --verbose, -v             Verbose output
    --quiet, -q               Quiet mode
    --help, -h                Show help
    --version                 Show version

  When invoked with no --format flag and no input files, launches
  the interactive TUI mode.

=cut

# ---------------------------------------------------------------------------
# Subcommand dispatch. Detect a leading verb that's not a flag and not a
# .dc file. Once dispatched, the subcommand handler exits the process.
# ---------------------------------------------------------------------------
my %SUBCOMMANDS = (
    init      => \&cmd_init,
    lint      => \&cmd_lint,
    anonymize => \&cmd_anonymize,
    diff      => \&cmd_diff,
    bundle    => \&cmd_bundle,
    batch     => \&cmd_batch,
    theme     => \&cmd_theme,
    audit     => \&cmd_audit,
);

if (@ARGV && exists $SUBCOMMANDS{ $ARGV[0] }) {
    my $cmd = shift @ARGV;
    $SUBCOMMANDS{$cmd}->();
    exit 0;
}

# ---------------------------------------------------------------------------
# Default file-process mode (the original CLI behaviour, extended).
# ---------------------------------------------------------------------------
my $format;
my $output_file;
my $config_file;
my $jurisdiction;
my $theme;
my $list_themes = 0;
my $batch_mode  = 0;
my $verbose     = 0;
my $quiet       = 0;
my $help        = 0;
my $version     = 0;
my $watermark;
my $watch       = 0;
my $do_lint     = 0;
my $do_audit    = 0;
my $no_preprocess = 0;
my $format_given = 0;

Getopt::Long::Configure('no_pass_through');
GetOptions(
    'format|f=s'      => sub { $format = $_[1]; $format_given = 1; },
    'output|o=s'      => \$output_file,
    'config|c=s'      => \$config_file,
    'jurisdiction|j=s'=> \$jurisdiction,
    'theme|t=s'       => \$theme,
    'list-themes'     => \$list_themes,
    'batch|b'         => \$batch_mode,
    'verbose|v'       => \$verbose,
    'quiet|q'         => \$quiet,
    'help|h'          => \$help,
    'version'         => \$version,
    'watermark=s'     => \$watermark,
    'watch'           => \$watch,
    'lint'            => \$do_lint,
    'audit-log'       => \$do_audit,
    'no-preprocess'   => \$no_preprocess,
) or pod2usage(2);

if ($list_themes) {
    print "Available themes:\n";
    for my $name (DC4U::Theme->available) {
        printf "  %-18s %s\n", $name, DC4U::Theme->desc($name);
    }
    exit 0;
}

if ($help) {
    pod2usage(1);
}

if ($version) {
    print "DC4U Version 2.0.0\n";
    exit 0;
}

if ($theme) {
    unless (DC4U::Theme->exists($theme)) {
        die "Error: Invalid theme '$theme'. Valid: "
            . join(', ', DC4U::Theme->available) . "\n";
    }
}

if ($jurisdiction) {
    my @valid_j = qw(singapore uk australia india malaysia);
    unless (grep { $_ eq $jurisdiction } @valid_j) {
        die "Error: Invalid jurisdiction '$jurisdiction'. Valid: "
            . join(', ', @valid_j) . "\n";
    }
}

my @input_files = @ARGV;

if (!$format_given && @input_files == 0) {
    require DC4U::TUI;
    my $tui = DC4U::TUI->new(config_file => $config_file);
    $tui->run();
    exit 0;
}

$format //= 'PDF';

if (@input_files == 0) {
    print "Error: No input files specified\n";
    pod2usage(2);
}

my @valid_formats = qw/PDF HTML TXT MD RMD DOCX/;
$format = uc($format);
unless (grep { $_ eq $format } @valid_formats) {
    die "Error: Invalid format '$format'. Valid formats: " . join(', ', @valid_formats) . "\n";
}

my $options = {
    log_level   => $verbose ? 'DEBUG' : ($quiet ? 'ERROR' : 'INFO'),
    config_file => $config_file,
};
$options->{jurisdiction}  = $jurisdiction if $jurisdiction;
$options->{theme}         = $theme        if $theme;
$options->{no_preprocess} = 1             if $no_preprocess;

# Pre-flight lint if requested. Errors abort; warnings print but proceed.
if ($do_lint) {
    require DC4U::Lint;
    my $lint = DC4U::Lint->new(jurisdiction => $jurisdiction // 'singapore');
    my $abort = 0;
    for my $f (@input_files) {
        my $issues = $lint->lint_file($f);
        if ($issues && @$issues) {
            print STDERR "$f:\n", DC4U::Lint->format_text($issues);
            $abort = 1 if DC4U::Lint->has_errors($issues);
        }
    }
    exit 2 if $abort;
}

my $process_one = sub {
    my $input_file = shift;
    unless (-f $input_file) {
        print "Error: File '$input_file' not found\n";
        return;
    }

    my $output = $output_file;
    if ($batch_mode || (!$output_file && @input_files >= 1)) {
        my ($name, $path, $suffix) = fileparse($input_file, qr/\.[^.]*$/);
        my $ext = lc($format);
        $ext = 'Rmd' if $ext eq 'rmd';
        $output = "${path}${name}.${ext}";
    }

    unless ($output) {
        print "Error: Output file not specified\n";
        return;
    }

    eval {
        $options->{output_format} = $format;
        my $results = DC4U::process_dc_file($input_file, $format, $options);

        unless ($results && @$results > 0) {
            print "Error: No output generated for $input_file\n";
            return;
        }

        if (defined $watermark && length $watermark) {
            require DC4U::Watermark;
            for my $r (@$results) {
                my $payload = ref $r eq 'HASH' ? $r->{output} : $r;
                $payload = DC4U::Watermark->apply($payload, $format, $watermark);
                if (ref $r eq 'HASH') { $r->{output} = $payload }
                else                  { $r          = $payload }
            }
        }

        if (@$results == 1) {
            my $payload = ref $results->[0] eq 'HASH' ? $results->[0]{output} : $results->[0];
            open my $fh, '>', $output or die "Cannot write to $output: $!";
            binmode $fh if $format =~ /^(PDF|DOCX)$/;
            print $fh $payload;
            close $fh;
            print "Generated: $output\n" unless $quiet;
            _audit($input_file, $output, $format, $jurisdiction, $payload, scalar(@$results)) if $do_audit;
        } else {
            if ($format =~ /^(HTML|TXT|MD|RMD)$/) {
                open my $fh, '>', $output or die "Cannot write to $output: $!";
                my $combined = '';
                for my $i (0 .. $#$results) {
                    my $sep = $i > 0 ? "\n--- Charge " . ($i + 1) . " ---\n\n" : '';
                    my $payload = ref $results->[$i] eq 'HASH' ? $results->[$i]{output} : $results->[$i];
                    print $fh $sep, $payload;
                    $combined .= $sep . $payload;
                }
                close $fh;
                print "Generated: $output (${\ scalar(@$results)} charges)\n" unless $quiet;
                _audit($input_file, $output, $format, $jurisdiction, $combined, scalar(@$results)) if $do_audit;
            } else {
                my ($name, $path, $suffix) = fileparse($output, qr/\.[^.]*$/);
                for my $i (0 .. $#$results) {
                    my $cfile = "${path}${name}-charge-" . ($i + 1) . "${suffix}";
                    my $payload = ref $results->[$i] eq 'HASH' ? $results->[$i]{output} : $results->[$i];
                    open my $fh, '>', $cfile or die "Cannot write to $cfile: $!";
                    binmode $fh if $format =~ /^(PDF|DOCX)$/;
                    print $fh $payload;
                    close $fh;
                    print "Generated: $cfile\n" unless $quiet;
                    _audit($input_file, $cfile, $format, $jurisdiction, $payload, 1) if $do_audit;
                }
            }
        }
    };
    if ($@) {
        print "Error processing $input_file: $@\n";
    }
};

if ($watch) {
    require DC4U::Watch;
    DC4U::Watch->run(
        paths     => \@input_files,
        on_change => sub { $process_one->($_[0]) },
        verbose   => $verbose,
    );
    exit 0;
}

for my $input_file (@input_files) {
    $process_one->($input_file);
}

exit 0;

# ---------------------------------------------------------------------------
# Subcommand handlers
# ---------------------------------------------------------------------------

sub cmd_init {
    require DC4U::Scaffold;
    my $force = 0;
    my $jur;
    GetOptions('force' => \$force, 'jurisdiction|j=s' => \$jur);
    my $jurisdiction = shift @ARGV;
    my $out          = shift @ARGV;
    if (defined $jur && !defined $out) {
        # `dc4u init -j singapore out.dc` form
        $out          = $jurisdiction;
        $jurisdiction = $jur;
    }
    unless (defined $jurisdiction && defined $out) {
        die "usage: dc4u init <jurisdiction> <out.dc>\n"
          . "       jurisdictions: " . join(', ', DC4U::Scaffold->jurisdictions) . "\n";
    }
    my $path = DC4U::Scaffold->write($jurisdiction, $out, $force);
    print "Scaffold written: $path\n";
}

sub cmd_lint {
    require DC4U::Lint;
    my $jur = 'singapore';
    GetOptions('jurisdiction|j=s' => \$jur);
    my @files = @ARGV;
    die "usage: dc4u lint [-j <jurisdiction>] <file.dc>...\n" unless @files;

    my $lint = DC4U::Lint->new(jurisdiction => $jur);
    my $any_errors = 0;
    for my $f (@files) {
        my $issues = $lint->lint_file($f);
        print "$f:\n", DC4U::Lint->format_text($issues);
        $any_errors = 1 if DC4U::Lint->has_errors($issues);
    }
    exit($any_errors ? 1 : 0);
}

sub cmd_anonymize {
    require DC4U::Anonymize;
    my $strategy   = 'redact';
    my $salt       = 'dc4u';
    my $out_path;
    my $in_place   = 0;
    my $scrub_off  = 0;
    my $scrub_dt   = 0;
    GetOptions(
        'strategy=s'    => \$strategy,
        'salt=s'        => \$salt,
        'output|o=s'    => \$out_path,
        'in-place'      => \$in_place,
        'scrub-officer' => \$scrub_off,
        'scrub-dates'   => \$scrub_dt,
    );
    unless (grep { $_ eq $strategy } qw(redact hash fake)) {
        die "Error: --strategy must be redact|hash|fake\n";
    }
    my @files = @ARGV;
    die "usage: dc4u anonymize [--strategy <s>] [-o out.dc | --in-place] <file.dc>...\n" unless @files;

    for my $f (@files) {
        open my $fh, '<', $f or die "Cannot open $f: $!";
        my $text = do { local $/; <$fh> };
        close $fh;

        my $clean = DC4U::Anonymize->scrub(
            $text,
            strategy      => $strategy,
            salt          => $salt,
            scrub_officer => $scrub_off,
            scrub_dates   => $scrub_dt,
        );

        my $dest;
        if ($in_place) { $dest = $f }
        elsif ($out_path && @files == 1) { $dest = $out_path }
        else {
            my ($n, $p, $s) = fileparse($f, qr/\.[^.]*$/);
            $dest = "${p}${n}.anon${s}";
        }
        open my $oh, '>', $dest or die "Cannot write $dest: $!";
        print $oh $clean;
        close $oh;
        print "Anonymized: $dest\n";
    }
}

sub cmd_diff {
    require DC4U::Diff;
    my $jur = 'singapore';
    GetOptions('jurisdiction|j=s' => \$jur);
    my ($a, $b) = @ARGV;
    die "usage: dc4u diff [-j <jurisdiction>] <a.dc> <b.dc>\n" unless $a && $b;
    my $d = DC4U::Diff->compare($a, $b, jurisdiction => $jur);
    print DC4U::Diff->format_text($d);
    exit(DC4U::Diff->has_changes($d) ? 1 : 0);
}

sub cmd_bundle {
    require DC4U::Bundle;
    my $out_dir   = './out';
    my $zip;
    my $jur;
    my $formats_s = 'PDF,HTML,TXT';
    GetOptions(
        'out=s'           => \$out_dir,
        'zip=s'           => \$zip,
        'jurisdiction|j=s'=> \$jur,
        'formats=s'       => \$formats_s,
    );
    my $input = shift @ARGV;
    die "usage: dc4u bundle [--out DIR] [--zip FILE] [--formats PDF,HTML] <file.dc>\n" unless $input;
    my @formats = map { uc } split /,/, $formats_s;

    my $r = DC4U::Bundle->build(
        input        => $input,
        formats      => \@formats,
        out_dir      => $out_dir,
        zip          => $zip,
        jurisdiction => $jur,
    );
    for my $a (@{ $r->{artifacts} }) {
        printf "  %s  %s  %d bytes  %s\n",
            $a->{format}, $a->{file}, $a->{bytes}, substr($a->{sha256}, 0, 12);
    }
    print "Manifest: $r->{manifest_path}\n";
    print "Zip:      $r->{zip_path}\n" if $r->{zip_path};
}

sub cmd_batch {
    require DC4U::BatchCSV;
    my ($csv, $tmpl, $out_dir, $format, $id_col, $jur);
    $out_dir = './out';
    $format  = 'PDF';
    GetOptions(
        'csv=s'           => \$csv,
        'template=s'      => \$tmpl,
        'out=s'           => \$out_dir,
        'format|f=s'      => \$format,
        'id-col=s'        => \$id_col,
        'jurisdiction|j=s'=> \$jur,
    );
    die "usage: dc4u batch --csv FILE --template FILE [-f FORMAT] [--out DIR] [--id-col COL]\n"
        unless $csv && $tmpl;
    my $r = DC4U::BatchCSV->run(
        csv          => $csv,
        template     => $tmpl,
        out_dir      => $out_dir,
        format       => $format,
        id_column    => $id_col,
        jurisdiction => $jur,
        on_render    => sub { my (undef, $p) = @_; print "  wrote $p\n"; },
    );
    print "Done: $r->{rows_processed} rows -> $r->{out_dir}\n";
}

sub cmd_theme {
    my $sub = shift @ARGV;
    $sub //= 'list';

    if ($sub eq 'list') {
        for my $name (DC4U::Theme->available) {
            printf "  %-18s %s\n", $name, DC4U::Theme->desc($name);
        }
    }
    elsif ($sub eq 'dir') {
        print DC4U::Theme->user_theme_dir, "\n";
    }
    elsif ($sub eq 'create') {
        my $base  = 'classic';
        my $force = 0;
        GetOptions('base=s' => \$base, 'force' => \$force);
        my $name = shift @ARGV;
        die "usage: dc4u theme create <name> [--base <theme>] [--force]\n" unless $name;
        unless (DC4U::Theme->exists($base)) {
            die "Error: --base $base is not a known theme\n";
        }
        my $path = DC4U::Theme->scaffold_user_theme($name, $base, $force);
        print "Created: $path\n";
        print "Edit then re-run dc4u to use it.\n";
    }
    else {
        die "Unknown theme subcommand '$sub'. Try: list, create, dir\n";
    }
}

sub cmd_audit {
    require DC4U::Audit;
    my $tail = 20;
    GetOptions('tail=i' => \$tail);
    my $audit = DC4U::Audit->new();
    print "audit log: ", $audit->path, "\n";
    my $lines = $audit->tail($tail);
    print "$_\n" for @$lines;
}

# Best-effort audit recording. Failures are silent so the audit log can
# never break a user's generation run.
sub _audit {
    my ($input, $outfile, $format, $jurisdiction, $payload, $charges) = @_;
    require DC4U::Audit;
    DC4U::Audit->new->record({
        input        => $input,
        outfile      => $outfile,
        format       => $format,
        jurisdiction => $jurisdiction // 'singapore',
        output       => $payload,
        charge_count => $charges // 1,
    });
}

